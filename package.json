{
  "name": "hannaex",
  "version": "2.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Bot de Discord",
  "main": "dist/index.js",
  "workspaces": [
    "apps/hoshiko",
    "apps/hoshiko-security"
  ],
  "scripts": {
    "test": "bash scripts/test.sh",
    "clean": "rimraf dist && npm run --prefix apps/hoshiko clean && npm run --prefix apps/hoshiko-security clean",
    "build:hoshiko": "npm run --prefix apps/hoshiko build",
    "build:security": "npm run --prefix apps/hoshiko-security build",
    "build": "npm run build:hoshiko && npm run build:security && rm -rf dist && ln -s apps/hoshiko/dist dist",
    "copy:assets": "npm run --prefix apps/hoshiko copy:assets",
    "start": "node dist/index.js",
    "start:security": "npm run --prefix apps/hoshiko-security start",
    "dev": "nodemon --exec \"ts-node --transpile-only\" apps/hoshiko/src/index.ts",
    "dev:security": "npm run --prefix apps/hoshiko-security dev",
    "deploy:guild": "NODE_ENV=staging node dist/scripts/deploy-commands.js",
    "deploy:dev": "NODE_ENV=development node dist/scripts/deploy-commands.js",
    "deploy:global": "NODE_ENV=production node dist/scripts/deploy-commands.js --global",
    "full-deploy:staging": "npm run build && npm run deploy:guild && npm run start:staging && npm run logs:staging",
    "full-deploy:prod": "npm run build && npm run deploy:global && npm run start:prod && npm run logs:prod",
    "start:staging": "pm2 startOrRestart ecosystem.config.js --only Hoshiko-Staging",
    "start:prod": "pm2 startOrRestart ecosystem.config.js --only hoshiko-bot --update-env",
    "start:security:prod": "pm2 startOrRestart ecosystem.security.config.js --only Hoshiko-Security --update-env",
    "stop:security": "pm2 stop Hoshiko-Security",
    "logs:security": "pm2 logs Hoshiko-Security",
    "stop:all": "pm2 delete all",
    "logs": "pm2 logs",
    "logs:staging": "pm2 logs Hoshiko-Staging",
    "logs:prod": "pm2 logs hoshiko-bot",
    "monit": "pm2 monit",
    "check:reply": "ts-node apps/hoshiko/src/scripts/checkReply.ts",
    "generate-licenses": "generate-license-file --input package.json --output licenses/ATTRIBUTIONS.md --overwrite",
    "sync:web-docs": "mkdir -p ../HoshikoWeb/public/docs && cp licenses/public/*.md ../HoshikoWeb/public/docs/ && cp licenses/public/TERMS_OF_SERVICE.md ../HoshikoWeb/Licenses/TERMS.md && cp licenses/public/PRIVACY_POLICY.md ../HoshikoWeb/Licenses/PRIVACY.md"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^0.1.90",
    "axios": "^1.20.0",
    "bullmq": "^6.3.12",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "genius-lyrics": "^4.4.7",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "mongoose": "^8.17.1",
    "ms": "^2.1.3",
    "node-cron": "^4.2.1",
    "pm2": "^7.0.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.10.9",
    "@types/node-cron": "^3.0.11",
    "copyfiles": "^1.0.0",
    "generate-license-file": "^4.2.5",
    "nodemon": "^3.1.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
