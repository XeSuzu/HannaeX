# Hoshiko Security - Environment Configuration
# Credenciales y variables independientes para la aplicación especializada de seguridad

# Discord Bot Token (Exclusivo para Hoshiko Security - NO reutilizar el de Hoshiko)
HOSHIKO_SECURITY_TOKEN=
HOSHIKO_SECURITY_CLIENT_ID=

# Entorno de ejecución (development, staging, production, test)
NODE_ENV=development

# Base de datos (MongoDB)
MONGO_URI=mongodb://localhost:27017/hoshiko

# Infraestructura de Caché y Colas (Redis)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Servidor de Salud / Métricas
SECURITY_PORT=8082
SECURITY_HEALTH_HOST=127.0.0.1
