{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "noEmit": true
  },
  "include": [
    "apps/hoshiko/src/**/*",
    "apps/hoshiko-security/src/**/*"
  ],
  "exclude": ["node_modules", "**/dist", "**/*.test.ts", "**/__tests__/**"]
}
