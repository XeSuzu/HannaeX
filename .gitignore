# ==============================================================================
# Hoshiko / HannaeX - Git Ignore Rules
# ==============================================================================

# --- Entorno y Secretos ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*

# --- Dependencias ---
node_modules/

# --- Compilación y Salidas ---
/dist
tsconfig.tsbuildinfo
coverage/
.nyc_output/

# --- Logs y Trazas ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Backups y Datos Locales ---
backups/
*.dump
*.rdb
*.sqlite
*.sqlite3
*.sql.gz
config.json
reports.json

# --- Scripts Manuales y Herramientas Locales ---
# (scripts/ con scripts esenciales como test.sh se mantiene versionado)
scripts-manuales/
src/scripts-manuales/
tools/

# --- Documentación Interna y Caches de Notas ---
# (docs/ y guías públicas se conservan versionadas)
Hoshiko Or Later/.obsidian/

# --- Agentes y Herramientas de IA (Temporales / Scratch) ---
.claude/
scratch/
.agents/**/scratch/
.agents/**/*.tmp
.agents/**/*.log

# --- Editores y Sistema Operativo ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
